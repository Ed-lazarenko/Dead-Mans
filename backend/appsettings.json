{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "DataProtection": {
    "KeysDirectory": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5180",
      "https://localhost:5180"
    ]
  },
  "TwitchAuth": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "http://localhost:5285/auth/twitch/callback",
    "FrontendRedirectUri": "http://localhost:5180/auth/callback",
    "Scopes": [ "openid" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Storage": {
    "PublicBaseUrl": "http://localhost:9000",
    "ServiceUrl": "http://localhost:9000",
    "BucketName": "deadman",
    "GamesPrefix": "games",
    "CardsGroup": "cards"
  },
  "ForwardedHeaders": {
    "Enabled": true,
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "TrustAllProxiesInDevelopment": true
  },
  "RateLimiting": {
    "Enabled": true,
    "Auth": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Reads": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    },
    "Realtime": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "Mutations": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
