{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5180 --strictPort",
    "build": "vite build",
    "typecheck": "tsc-files src/main.tsx --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check:locales": "node scripts/check-locale-keys.mjs",
    "check:hardcoded-ui": "node scripts/check-hardcoded-ui-text.mjs",
    "check:i18n": "npm run check:locales && npm run check:hardcoded-ui",
    "audit:i18n-duplicates": "node scripts/audit-duplicate-translations.mjs",
    "knip": "knip",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run check:i18n && npm run test:coverage && npm run knip && npm run build",
    "generate:contracts": "openapi-typescript ../backend/openapi/deadmans.v1.yaml -o src/shared/api/contracts/generated.d.ts",
    "generate:realtime": "node scripts/generate-realtime-contracts.mjs",
    "generate:transport": "npm run generate:contracts && npm run generate:realtime",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@microsoft/signalr": "^10.0.11",
    "@mui/material": "^7.3.11",
    "@mui/system": "^7.3.11",
    "@tanstack/react-query": "^5.102.8",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^16.6.6",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "baseline-browser-mapping": "^2.11.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "knip": "^5.30.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tsc-files": "^1.1.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
