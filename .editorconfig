root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csproj,slnx,md,mdc,yaml,yml,json,js,mjs,ts,tsx}]
indent_style = space

[*.cs]
indent_size = 4

[backend/**/*.cs]
# Source-generated logging remains an IDE optimization hint; correctness analyzers still gate builds.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

[backend/Data/Migrations/*.cs]
# EF migrations and the model snapshot are generated artifacts and must not be hand-optimized.
generated_code = true

[backend/tests/**/*.cs]
# Behavior-driven test names intentionally use Method_State_Expectation notation.
dotnet_diagnostic.CA1707.severity = none
# Concrete collection and serializer-option micro-optimizations do not improve test production paths.
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1869.severity = none
